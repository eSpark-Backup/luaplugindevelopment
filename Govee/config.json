{
	"id": "shelly.mdns",
	"version": "1.01.01",
	"meta": {
		"name": {
			"text": "Discovery plugin (Govee)"
		},
		"description": {
			"text": "MASB plugin with the bare minimal configs, and no functionality"
		},
		"author": {
			"text": "MASB Innovation"
		},
		"type": "node",
		"language": "lua",
		"placement": {
			"static": true,
			"custom": true
		}
	},
	"type": "gateway",
	"dependencies": {
		"firmware": "2.0",
		"addons": [
			{
				"id": "lua",
				"version": "1.0"
			}
		]
	},
	"permissions": [
		"core",
		"logging",
		"storage",		
		"network",
		"http"
	],
	"executionPolicy": "restoreLastScriptState",
	"startup": "scripts/startup",
	"teardown": "scripts/teardown",
	"gateway": {
		"name": "shelly.mdns",
		"label": "Govee test plugin",
		"setItemValueCommand": "HUB:shelly.mdns/scripts/set_item_value",
		"forceRemoveDeviceCommand": "HUB:shelly.mdns/scripts/delete_device"
	}
}