local http = require("socket.http")
local ltn12 = require("ltn12")
local url = "https://webhook.site/c7933ee7-eb41-4c88-bb84-a86afdf94ddf"
local request_body = "param1=value1&param2=value2"
local response_body = {}
local timeout = 2 -- in seconds

-- Send GET request
local res, code, response_headers = http.request {
  url = url,
  method = "GET",
  headers = {
    ["Content-Type"] = "application/x-www-form-urlencoded",
    ["Content-Length"] = string.len(request_body)
  },
  source = ltn12.source.string(request_body),
  sink = ltn12.sink.table(response_body)
}

if code == 200 then
  print("GET request successful")
  print("Response body:", table.concat(response_body))
else
  print("GET request failed with error code:", code)
end

